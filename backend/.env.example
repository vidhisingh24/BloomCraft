# ============================================================================
# BloomCraft backend — environment template (backend/.env.example)
# Copy to backend/.env for local development. Never commit real values.
# File paths are repo-root-relative (backend/...); the app resolves them
# independently of the working directory. *_FILE files live in backend/secrets/.
# ============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=development                        # development | test | production
APP_NAME=bloomcraft-api
API_BASE_URL=http://localhost:8000         # public origin of this API
API_PREFIX=/api/v1
FRONTEND_BASE_URL=http://localhost:5173    # SPA origin; OAuth results redirect here
CORS_ALLOWED_ORIGINS=http://localhost:5173 # comma-separated exact origins
TRUSTED_PROXY_IPS=                         # comma-separated reverse-proxy IPs (production only)
LOG_LEVEL=INFO
LOG_FORMAT=console                         # console (dev) | json (production)
BUSINESS_TIMEZONE=Asia/Kolkata
ENABLE_API_DOCS=true                       # always false in production

# ---- PostgreSQL 18 (Windows service postgresql-x64-18) ---------------------
DATABASE_URL=postgresql+asyncpg://bloomcraft_app:CHANGE_ME@127.0.0.1:5432/bloomcraft
DATABASE_MIGRATOR_URL=postgresql+asyncpg://bloomcraft_migrator:CHANGE_ME@127.0.0.1:5432/bloomcraft
TEST_DATABASE_URL=postgresql+asyncpg://bloomcraft_app:CHANGE_ME@127.0.0.1:5432/bloomcraft_test
TEST_DATABASE_MIGRATOR_URL=postgresql+asyncpg://bloomcraft_migrator:CHANGE_ME@127.0.0.1:5432/bloomcraft_test
DB_SCHEMA=bloomcraft
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000

# ---- Sessions, cookies, CSRF ------------------------------------------------
COOKIE_PREFIX=                             # production: __Host-  (gives __Host-bc_session etc.)
COOKIE_SECURE=false                        # production: true (enforced at startup)
COOKIE_SAMESITE=lax
SESSION_IDLE_TTL_SECONDS=604800            # customer/seller: 7 days
SESSION_ABSOLUTE_TTL_SECONDS=2592000       # customer/seller: 30 days
ADMIN_SESSION_IDLE_TTL_SECONDS=1800        # admin: 30 minutes
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=43200   # admin: 12 hours
STEP_UP_MAX_AGE_SECONDS=600
CSRF_SECRET_FILE=backend/secrets/csrf_secret.key

# ---- Cryptography (keys generated by the setup prompt) ---------------------
FIELD_ENCRYPTION_KEYRING_FILE=backend/secrets/field_keyring.json
BLIND_INDEX_KEY_FILE=backend/secrets/blind_index.key
PASSWORD_PEPPER_FILE=backend/secrets/password_pepper.key
OTP_HMAC_KEY_FILE=backend/secrets/otp_hmac.key
CURSOR_SIGNING_KEY_FILE=backend/secrets/cursor_signing.key
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=128
HIBP_CHECK_ENABLED=false

# ---- Google OAuth 2.0 / OpenID Connect -------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                      # either this or GOOGLE_CLIENT_SECRET_FILE
GOOGLE_CLIENT_SECRET_FILE=backend/secrets/google_client_secret.txt
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OAUTH_REDIRECT_BASE_URL=http://localhost:8000   # redirect URI = {this}{API_PREFIX}/auth/google/callback
OAUTH_TRANSACTION_TTL_SECONDS=600
OAUTH_PENDING_SIGNUP_TTL_SECONDS=900

# ---- Two-step sign-in (TOTP) -----------------------------------------------
TOTP_ISSUER=BloomCraft
ADMIN_MFA_REQUIRED=true

# ---- Email (SMTP) — dev: Mailpit SMTP 127.0.0.1:1025, UI http://127.0.0.1:8025
EMAIL_BACKEND=smtp                         # smtp | console
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD_FILE=backend/secrets/smtp_password.txt
SMTP_SECURITY=none                         # none (dev only) | starttls | tls
EMAIL_FROM="BloomCraft <no-reply@bloomcraft.in>"
EMAIL_REPLY_TO=hello@bloomcraft.in
MAILPIT_API_URL=http://127.0.0.1:8025      # dev/test only

# ---- WhatsApp Business Platform (Cloud API) — off until Meta setup is done -
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=                # current version from Meta's Graph API changelog
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN_FILE=backend/secrets/whatsapp_token.txt
WHATSAPP_APP_SECRET_FILE=backend/secrets/whatsapp_app_secret.txt           # verifies X-Hub-Signature-256
WHATSAPP_WEBHOOK_VERIFY_TOKEN_FILE=backend/secrets/whatsapp_verify_token.txt
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_PLACED=bc_order_placed_v1
WHATSAPP_TEMPLATE_SELLER_NEW_ORDER=bc_seller_new_order_v1
WHATSAPP_TEMPLATE_ORDER_STATUS=bc_order_status_v1
WHATSAPP_TEMPLATE_OTP=bc_otp_v1

# ---- SMS (optional; India requires TRAI DLT registration) ------------------
SMS_ENABLED=false
SMS_PROVIDER=msg91
MSG91_AUTH_KEY_FILE=backend/secrets/msg91_auth_key.txt
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID_OTP=
MSG91_DLT_TEMPLATE_ID_ORDER=

# ---- Media -------------------------------------------------------------------
MEDIA_BACKEND=local                        # local | s3 (later)
MEDIA_ROOT=backend/var/media
MEDIA_PRIVATE_ROOT=backend/var/private_media
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_MAX_PIXELS=40000000

# ---- Worker (outbox dispatcher) ---------------------------------------------
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_CONCURRENCY_AUTH=4
WORKER_CONCURRENCY_TRANSACTIONAL=4
WORKER_CONCURRENCY_BULK=1
OUTBOX_MAX_ATTEMPTS=8
OTP_MESSAGE_STALE_AFTER_SECONDS=120

# ---- Business defaults -------------------------------------------------------
FOUNDING_SELLER_EMAIL=                     # default seller for seeds, legacy orders, custom requests
LEGACY_IMPORT_DIR=backend/var/imports
REQUIRE_VERIFIED_PHONE_FOR_CHECKOUT=false  # set true once WhatsApp or SMS codes are live
SELLER_PII_VISIBLE_DAYS_AFTER_CLOSE=30

# ---- Rate limits (count/window_seconds) -------------------------------------
RATE_LIMIT_LOGIN_ACCOUNT=5/900
RATE_LIMIT_LOGIN_IP=30/900
RATE_LIMIT_REGISTER_START_EMAIL=3/900
RATE_LIMIT_REGISTER_START_IP=10/3600
RATE_LIMIT_PASSWORD_FORGOT_EMAIL=3/3600
RATE_LIMIT_PASSWORD_FORGOT_IP=10/3600
RATE_LIMIT_OTP_SEND_TARGET=3/900
RATE_LIMIT_OTP_SEND_TARGET_DAILY=10/86400
RATE_LIMIT_OTP_SEND_USER=5/3600
RATE_LIMIT_MFA_VERIFY_USER=5/300
RATE_LIMIT_GOOGLE_START_IP=20/600
RATE_LIMIT_CHECKOUT_USER=10/60
RATE_LIMIT_CUSTOM_REQUEST_USER=5/86400
RATE_LIMIT_UPLOAD_USER=30/3600
RATE_LIMIT_GLOBAL_IP=300/60
