# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.

# ── Required: Supabase (Project Settings → API) ─────────────────────────────
# The URL and the *public* anon / publishable key. Never put the service_role key here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# "Continue with Google" button: "true" after Google is switched on in Supabase → Authentication.
VITE_ENABLE_GOOGLE_LOGIN="true"

# ── Optional: shop details (defaults already hold the real values) ─────────
VITE_BUSINESS_NAME="BLOOMCRAFT"
VITE_TAGLINE="Handcrafted with love, made to bloom."
VITE_WHATSAPP_NUMBER="919316097667"
VITE_WHATSAPP_FORMATTED="+91 93160 97667"
VITE_INSTAGRAM_HANDLE="@bloomcraftt.co"
VITE_INSTAGRAM_URL="https://www.instagram.com/bloomcraftt.co/"
VITE_SUPPORT_EMAIL=""            # optional public support e-mail (shown on receipts and the privacy page)
VITE_UPI_ID="vidhiisingh2403@okicici"
VITE_UPI_PAYEE_NAME="Vidhi Singh"
